! coreloss.odi -- OptaDOS core-loss, POLYCRYSTALLINE (isotropic average). Use for the M2(b)
! benchmark (compare shape/onset to a known TiO2/SrTiO3 ELNES). Broadening + core_type match
! the OptaDOS Mizoguchi example. For the M4 anisotropy use coreloss_qc.odi / coreloss_qperp.odi.
!   optados <seed>        # with this as <seed>.odi

task                 : core
core_type            : absorption      ! EELS/XAS absorption edge
dos_spacing          : 0.01
broadening           : adaptive
adaptive_smearing    : 0.2
core_LAI_broadening  : true            ! life-time + instrument broadening
LAI_gaussian_width   : 1.0             ! eV, instrument
LAI_lorentzian_width : 0.5             ! eV, core-hole lifetime
LAI_lorentzian_scale : 0.1
! core_geom defaults to POLYCRYSTALLINE (isotropic) when omitted -> the benchmark spectrum.
