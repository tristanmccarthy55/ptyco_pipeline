! coreloss_qc.odi -- q PARALLEL to the polar axis c (= beam for tet_Pz) == "P along beam".
! Difference (qc - qperp) = the ELNES dichroism = the along-beam polarisation signal (M4).
task                 : core
core_type            : absorption
core_geom            : polarized       ! single q direction (anisotropic)
core_qdir            : 0.0 0.0 1.0      ! q || c (beam). tet_Px swaps axes -> use 1 0 0 there.
dos_spacing          : 0.01
broadening           : adaptive
adaptive_smearing    : 0.2
core_LAI_broadening  : true
LAI_gaussian_width   : 1.0
LAI_lorentzian_width : 0.5
LAI_lorentzian_scale : 0.1
