! coreloss.param -- M2(b)/M3/M4 core-hole ELNES SCF. Matches the OptaDOS Mizoguchi/NaGe
! working example for CASTEP 24.1. Pair with a core-hole .cell from structures/corehole/
! (excited atom labelled X:exc, with the %BLOCK SPECIES_POT ...{1s1}/{2p5} appended by
! build_cells.py). CASTEP writes the binaries OptaDOS `task:core` then reads.
!
!   castep.mpi <seed>     # this SCF
!   optados   <seed>      # reads <seed>.odi (task:core) -> the spectrum

task            : spectral
spectral_task   : coreloss
xc_functional   : PBE
cut_off_energy  : 800 eV        ! same as the M2(a) ground state (convergence-checked there)
charge          : +1            ! FULL core hole: one electron removed with the 1s/2p/3d hole
nextra_bands    : 100           ! many empty bands span the edge (~30-50 eV above onset)
write_checkpoint : none

! Absolute edge onset (optional, for comparing to experiment) = the Mizoguchi chemical shift
! from a separate no-hole singlepoint (templates/groundstate.param) + tools/miz_chemical_shift.
! NOT needed for the q||c - q-perp DICHROISM (a difference), which is our primary observable.
